#!/usr/bin/python3
from OpenDirectory import ODNode, ODSession, kODNodeTypeConfigure
from Foundation import NSMutableData, NSData
import shutil
import time
import platform
import os
import hashlib

termwidth = os.get_terminal_size()[0]-1

print("Region 1 MacOS LDAP Provisioner".center(termwidth, '='))

def fallback():
    p12Path = ""
    plistPath = ""
    print("Unable to find files!".center(termwidth, '='))
    print("They might just not be in the right place.")
    print("I'm going to prompt you to choose one file, then the other.")
    from tkinter.filedialog import askopenfilename
    print("Please select the p12 file".center(termwidth, '-'))
    print("\n\n")
    time.sleep(0.5)
    p12Path = askopenfilename()
    print("processing...")
    time.sleep(3.5) #sleep to prevent macos file chooser from crashing
    print("Great, now select the plist file".center(termwidth, '-'))
    print("\n\n")
    time.sleep(2)
    plistPath = askopenfilename()
    print("Found both files, proceeding...")
    time.sleep(0.1)
    return p12Path, plistPath

def DomainChooser():
    curPath = os.getcwd() + "/" # may seem silly but I like to use absolute pathing everywhere
    pathContent = os.scandir(curpath)
    dirs = []
    for i in pathContent:
        if i.is_dir() and i.name[0] != '.':
            dirs.append(i.name)
    match len(dirs):
        case 0:
            print("CRITICAL: Cannot find any domain information! Entering fallback...")
            
        case 1:
            print("Found 1 domain: '{}.' Moving on.")
            curPath += dirs[0]
        case _:
            print("Found {} Domains:".format(len(dirs)))
            for i in range(0,len(dirs)):
                print("{}) {}".format(i+1, dirs[i]))
            try:
                choice = int(input("Select an option [1]: "))-1
            except(ValueError):
                print("That wasn't a number!")
                return DomainChooser()
            curPath += dirs[choice]
        curPath += "/"

def readHashFile(curPath):
    hashPath = curPath+"hashes"
    try:
        h = open(hashPath, 'r')
    except(FileNotFoundError):
        return False
    hashes = h.readlines()
    h.close()
    hDict = {}
    for i in hashes:
        dat = i.split('\t')
        hDict[dat[0]]=dat[1]
    return hDict

def hashFail():
    os.system(clear)
    print("#".center(termwidth,'#'))
    print("Failed To Validate Files!".center(termwidth, '='))
    print("#".center(termwidth,'#'))
    print("\n One or more files does not match expected hash. Please re-download all files for this script and try again.")
    print("Proceeding with these files is not reccomended and may require an OS reinstall to fix.")
    if input("Proceed anyway? (y/N)").casefold() != 'y':
        print("aborting.\n")
        exit()
    print("As you wish.")
    return

def fileFinder():
    curPath = DomainChooser()
    if platform.machine() == 'x86_64': 
        p12Path = curPath+"intel-client.p12"
        print("This is an intel Mac")
    else: 
        p12Path = curPath+"arm-client.p12"
        print("This is an ARM Mac")
        
    plistPath = curPath+"ldap.google.com.plist"

    print("\n Checking files...")
    if (os.path.exists(plistPath) and os.path.exists(p12Path)):
        print("Files exits.")
    else:
        return fallback()
    hashes = readHashFile()
    if len(hashes) == 0:
        hashFail()
        return p12Path, plistPath
    isOk = True
    for i in [plistPath, p12Path]:
        isOk &= (hashlib.md5(open(i,'rb').read()).hexdigest() == hashes[i.split('/')[-1]])
    if not isOk:
        hashFail()
    else:
        print("Files Found and Validated!")
    return p12Path, plistPath
    
p12Path, plistPath = fileFinder()
print("File Operations Complete! Configuring LDAP...".center(termwidth, '-'))
# Reading plist
GOOGLELDAPCONFIGFILE = open(plistPath, "r")
CONFIG = GOOGLELDAPCONFIGFILE.read().encode()
GOOGLELDAPCONFIGFILE.close()
# Write the plist
print("Writing system configuration...")
od_session = ODSession.defaultSession()
od_conf_node, err = ODNode.nodeWithSession_type_error_(od_session, kODNodeTypeConfigure, None)
request = NSMutableData.dataWithBytes_length_(b'\x00'*32, 32)
print("...")
request.appendData_(NSData.dataWithBytes_length_(CONFIG, len(CONFIG)))
response, err = od_conf_node.customCall_sendData_error_(99991, request, None)
print("Configuring domain login...")
# Edit the default search path and append the new node to allow for login
if os.system("dscl -q localhost -append /Search CSPSearchPath /LDAPv3/ldap.google.com"):
    print("FATAL DSCL ERROR! ABORT!".center(termwidth, '='))
    print("Help: this is typically due to a corrupted plist file.")
    exit()
print("Configuring TLS...")
os.system("bash -c 'echo -e \"TLS_IDENTITY\tLDAP Client\" >> /etc/openldap/ldap.conf' ")
print("...")
print("LDAP Configuration Complete! Attempting to import certs...".center(termwidth, '-'))
if os.system("security import {} -k /Library/Keychains/System.keychain -f pkcs12 -P ***REMOVED*** -T /System/Library/CoreServices/Applications/Directory\ Utility.app/Contents/MacOS/Directory\ Utility -T /usr/libexec/opendirectoryd -T /usr/bin/dscl".format(p12Path)):
    print("FATAL KEYCHAIN ERROR! ABORT!".center(termwidth, '='))
    print("Help: this is typically due to using an Intel p12 file on an M1 mac or vice-versa.")
    exit()
print("Setting login screen preferences...")
os.system("defaults write /Library/Preferences/com.apple.loginwindow SHOWFULLNAME -bool TRUE")
os.system('defaults write /Library/Preferences/com.apple.loginwindow LoginwindowText "By logging on to this system you are agreeing to abide by the terms of the Region1 acceptable use policy."')
st = time.time() + 6
while True:
    try:
        remain = st-time.time()
        print("Done! Restarting in {}s... (Press Crtl+C to add FileVault users)".format(round(remain, 0)), end='\r')
        if remain <= 0:
            break
        time.sleep(0.25)
    except(KeyboardInterrupt):
        print("\nEntering FV helper...\n")
        os.system("python3 fvHelper.py")
        st = time.time() + 5
print("\n\nGoodbye")
os.system("reboot")
