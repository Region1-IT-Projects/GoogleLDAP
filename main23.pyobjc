#!/usr/bin/python3
from OpenDirectory import ODNode, ODSession, kODNodeTypeConfigure
from Foundation import NSMutableData, NSData
import shutil
import time
import platform
import os
import hashlib

termwidth = os.get_terminal_size()[0]

def fallback():
    p12Path = ""
    plistPath = ""
    print("Unable to find files!".center(termwidth, '='))
    print("They might just not be in the right place.")
    print("I'm going to prompt you to choose one file, then the other.")
    from tkinter.filedialog import askopenfilename
    print("Please select the p12 file".center(termwidth, '-'))
    time.sleep(0.5)
    p12Path = askopenfilename()
    print("processing...")
    time.sleep(3.5) #sleep to prevent macos file chooser from crashing
    print("\nGreat, now select the plist file".center(termwidth, '-'))
    time.sleep(1)
    plistPath = askopenfilename()
    return p12Path, plistPath

print("Region 1 MacOS LDAP Provisioner".center(termwidth, '='))
if (os.getcwd() == '/Volumes/LDAP'):
        print("\n Running from USB, checking files...")
        if platform.machine() == 'x86_64': 
            tempP12 = "/Volumes/LDAP/clients/intel-client.p12"
            print("This is an intel Mac")
        else: 
            tempP12 = "/Volumes/LDAP/clients/arm-client.p12"
            print("This is an ARM Mac")
        tempPlist = "/Volumes/LDAP/ldap.google.com.plist"
        if (os.path.exists(tempPlist) and os.path.exists(tempP12)):
            print("Files Located!")
        else: tempP12, tempPlist = fallback()
else: tempP12, tempPlist = fallback()
shutil.copyfile(tempP12, "/tmp/HVRHSldap.p12")
shutil.copyfile(tempPlist, "/tmp/ldap.google.com.plist")
print("File Operations Complete! Configuring LDAP...".center(termwidth, '-'))
# Reading plist
GOOGLELDAPCONFIGFILE = open("/tmp/ldap.google.com.plist", "r")
CONFIG = GOOGLELDAPCONFIGFILE.read().encode()
GOOGLELDAPCONFIGFILE.close()
# Write the plist
od_session = ODSession.defaultSession()
od_conf_node, err = ODNode.nodeWithSession_type_error_(od_session, kODNodeTypeConfigure, None)
request = NSMutableData.dataWithBytes_length_(b'\x00'*32, 32)
print("...")
request.appendData_(NSData.dataWithBytes_length_(CONFIG, len(CONFIG)))
response, err = od_conf_node.customCall_sendData_error_(99991, request, None)
print("...")
# Edit the default search path and append the new node to allow for login
if os.system("dscl -q localhost -append /Search CSPSearchPath /LDAPv3/ldap.google.com"):
    print("FATAL DSCL ERROR! ABORT!".center(termwidth, '='))
    print("Help: this is typically due to a corrupted plist file.")
    exit()
os.system("bash -c 'echo -e \"TLS_IDENTITY\tLDAP Client\" >> /etc/openldap/ldap.conf' ")
print("...")
print("LDAP Configuration Complete! Attempting to import certs...".center(termwidth, '-'))
if os.system("security import /tmp/HVRHSldap.p12 -k /Library/Keychains/System.keychain -f pkcs12 -P ***REMOVED*** -T /System/Library/CoreServices/Applications/Directory\ Utility.app/Contents/MacOS/Directory\ Utility -T /usr/libexec/opendirectoryd -T /usr/bin/dscl"):
    print("FATAL KEYCHAIN ERROR! ABORT!".center(termwidth, '='))
    print("Help: this is typically due to using an Intel p12 file on an M1 mac or vice-versa.")
    exit()

st = time.time() + 5
while True:
    remain = st-time.time()
    print("Done! Restarting in {}s...".format(round(remain, 0)), end='\r')
    if remain <= 0:
        break
print("Goodbye")
os.system("reboot")
