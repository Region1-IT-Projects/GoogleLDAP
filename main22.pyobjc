#!/usr/bin/python3
from OpenDirectory import ODNode, ODSession, kODNodeTypeConfigure
from Foundation import NSMutableData, NSData
import shutil
import time
import platform
import os
import hashlib

def fallback():
    print("Can't locate files, entering fallback mode...") 
    if(raw_input("Do you want to provide file paths manually? (y/N) ").lower()) != 'y':
        exit()
    tempP12 = raw_input("Please type the FULL filepath of the p12 file:  ")
    tempPlist = raw_input("Please type the FULL filepath of the plist file:  ")
    if(raw_input('There is no input validation on the paths you just entered. \n If you accept the risks of this dangerous practice type "I understand." here.')) != "I understand.":
        exit()
    print ("If you say so...")
    time.sleep(2)

if (os.getcwd() == '/Volumes/LDAP'):
        print("I think that this script is running from USB, checking files...")
        if platform.machine() == 'x86_64': 
            tempP12 = "/Volumes/LDAP/ldap-client-intel.p12"
            print("This is an Intel Mac")
        else: 
            tempP12 = "/Volumes/LDAP/ldap-client-M1.p12"
            print("This is an ARM Mac")
        tempPlist = "/Volumes/LDAP/ldap.google.com.plist"
        if (os.path.exists(tempPlist) and os.path.exists(tempP12)):
            print("\n ====Files Located!==== \n")
        else: fallback()
else: fallback()
shutil.copyfile(tempP12, "/tmp/HVRHSldap.p12")
shutil.copyfile(tempPlist, "/tmp/ldap.google.com.plist")
print("\n ====File Operations Complete! Configuring LDAP...==== \n")
# Reading plist
GOOGLELDAPCONFIGFILE = open("/tmp/ldap.google.com.plist", "r")
CONFIG = GOOGLELDAPCONFIGFILE.read().encode()
GOOGLELDAPCONFIGFILE.close()
# Write the plist
od_session = ODSession.defaultSession()
od_conf_node, err = ODNode.nodeWithSession_type_error_(od_session, kODNodeTypeConfigure, None)
request = NSMutableData.dataWithBytes_length_(b'\x00'*32, 32)
print("...")
request.appendData_(NSData.dataWithBytes_length_(CONFIG, len(CONFIG)))
response, err = od_conf_node.customCall_sendData_error_(99991, request, None)
print("...")
# Edit the default search path and append the new node to allow for login
if os.system("dscl -q localhost -append /Search CSPSearchPath /LDAPv3/ldap.google.com"):
    print("\n####################\n====FATAL DSCL ERROR! ABORT!====\n####################\n")
    print("Help: this is typically due to a corrupted plist file.")
    exit()
os.system("bash -c 'echo -e \"TLS_IDENTITY\tLDAP Client\" >> /etc/openldap/ldap.conf' ")
print("...")
print("\n ====LDAP Configuration Complete! Attempting to import certs...====")
if os.system("security import /tmp/HVRHSldap.p12 -k /Library/Keychains/System.keychain -f pkcs12 -P indigo -T /System/Library/CoreServices/Applications/Directory\ Utility.app/Contents/MacOS/Directory\ Utility -T /usr/libexec/opendirectoryd -T /usr/bin/dscl"):
    print("\n###########################\n====FATAL KEYCHAIN ERROR! ABORT!====\n###########################\n")
    print("Help: this is typically due to using an Intel p12 file on an M1 mac or vice-versa.")
    exit()
print("\n ====Done! Restarting in 1s==== \n")
time.sleep(1)
os.system("reboot")
